<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Connection Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connection Status"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/connection_indicator"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@android:drawable/presence_offline" />

                    <TextView
                        android:id="@+id/connection_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Disconnected"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/printer_state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_blue_dark" />

                </LinearLayout>

                <Button
                    android:id="@+id/reconnect_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reconnect"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Temperature Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperatures"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Nozzle Temperature -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nozzle"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/nozzle_temp_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="20°C / 0°C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/nozzle_temp_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:max="250"
                        android:progress="20" />

                </LinearLayout>

                <!-- Bed Temperature -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bed"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/bed_temp_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="20°C / 0°C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/bed_temp_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="20" />

                </LinearLayout>

                <!-- Temperature Graph -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperature History"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <com.chinmay.myprinter.ui.home.TemperatureGraphView
                    android:id="@+id/temperature_graph"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="12dp" />

                <!-- Temperature Control Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/heat_nozzle_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Heat Nozzle"
                        android:textSize="11sp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/cooldown_nozzle_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Cool Nozzle"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/heat_bed_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Heat Bed"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/cooldown_bed_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Cool Bed"
                        android:textSize="11sp"
                        android:layout_marginStart="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Camera Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.chinmay.myprinter.ui.camera.CameraView
                    android:id="@+id/camera_view"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/camera_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Camera: Not configured"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <Button
                        android:id="@+id/refresh_camera_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Position & Movement Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Position &amp; Movement"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/position_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X: 0.0  Y: 0.0  Z: 0.0"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp" />

                <!-- Movement Controls -->
                <LinearLayout
                    android:id="@+id/movement_controls_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jog Controls (10mm)"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- X/Y Movement Grid -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:layout_marginBottom="12dp">

                    <!-- Row 1 -->
                    <Space android:layout_width="60dp" android:layout_height="60dp" />
                    <Button
                        android:id="@+id/move_y_plus"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="Y+"
                        android:textSize="12sp"
                        android:layout_margin="2dp" />
                    <Space android:layout_width="60dp" android:layout_height="60dp" />

                    <!-- Row 2 -->
                    <Button
                        android:id="@+id/move_x_minus"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="X-"
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:layout_gravity="center_vertical" />
                    <Button
                        android:id="@+id/home_all_button"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="HOME"
                        android:textSize="10sp"
                        android:layout_margin="2dp"
                        android:layout_gravity="center_vertical" />
                    <Button
                        android:id="@+id/move_x_plus"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="X+"
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:layout_gravity="center_vertical" />

                    <!-- Row 3 -->
                    <Space android:layout_width="60dp" android:layout_height="60dp" />
                    <Button
                        android:id="@+id/move_y_minus"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="Y-"
                        android:textSize="12sp"
                        android:layout_margin="2dp" />
                    <Space android:layout_width="60dp" android:layout_height="60dp" />

                </GridLayout>

                <!-- Z Movement -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/move_z_minus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Z -"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Z Axis"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/move_z_plus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Z +"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                </LinearLayout>
                <!-- End Movement Controls -->

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Print Progress Card (visible when printing) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/print_progress_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Print Progress"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/print_filename_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="filename.gcode"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/print_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/print_progress_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/print_layer_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layer 100/200"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/print_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duration: 0:30:15"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/print_time_remaining_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining: 1:15:30"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/print_finish_time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finish: Today at 3:45 PM"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/pause_print_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Pause"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/cancel_print_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Cancel" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Files Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G-Code Files"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/files_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_gcode_file"
                    tools:itemCount="3" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
